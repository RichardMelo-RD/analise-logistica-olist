        "partitions": [
          {
            "name": "Entregas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(File.Contents(CaminhoCSV), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),",
                "    // O CSV usa ponto como separador decimal: a conversão usa a cultura en-US",
                "    // para funcionar em qualquer Windows (inclusive em português).",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {",
                "        {\"order_id\", type text},",
                "        {\"data_compra\", type date},",
                "        {\"mes_compra\", type date},",
                "        {\"uf_vendedor\", type text},",
                "        {\"uf_cliente\", type text},",
                "        {\"regiao_cliente\", type text},",
                "        {\"tipo_rota\", type text},",
                "        {\"qtd_itens\", Int64.Type},",
                "        {\"valor_produtos\", type number},",
                "        {\"valor_frete\", type number},",
                "        {\"frete_pct_produto\", type number},",
                "        {\"dias_aprovacao\", type number},",
                "        {\"dias_expedicao\", type number},",
                "        {\"dias_transporte\", type number},",
                "        {\"lead_time_dias\", type number},",
                "        {\"prazo_prometido_dias\", Int64.Type},",
                "        {\"dias_atraso\", Int64.Type},",
                "        {\"entregue_no_prazo\", type logical},",
                "        {\"vendedor_postou_no_prazo\", type logical},",
                "        {\"faixa_atraso\", type text},",
                "        {\"nota_avaliacao\", Int64.Type}",
                "    }, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Pedidos",
            "expression": "COUNTROWS(Entregas)",
            "formatString": "#,0",
            "displayFolder": "KPIs",
            "lineageTag": "6a5968ce-42c2-4c24-8b74-4c764dde8db9"
          },
          {
            "name": "% No Prazo",
            "expression": [
              "DIVIDE(",
              "    CALCULATE(COUNTROWS(Entregas), Entregas[entregue_no_prazo] = TRUE()),",
              "    COUNTROWS(Entregas)",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "KPIs",
            "lineageTag": "210f9f7e-8b39-47d3-872e-c022a3b97020"
          },
          {
            "name": "Pedidos Atrasados",
            "expression": "CALCULATE(COUNTROWS(Entregas), Entregas[entregue_no_prazo] = FALSE())",
            "formatString": "#,0",
            "displayFolder": "KPIs",
            "lineageTag": "6100c581-9198-4bcd-8576-80296b6b80f5"
          },
          {
            "name": "Lead Time Médio",
            "expression": "AVERAGE(Entregas[lead_time_dias])",
            "formatString": "0.0\" dias\"",
            "displayFolder": "KPIs",
            "lineageTag": "a6f0fee6-755e-4ce4-8ee5-fcaf4f34ed92"
          },
          {
            "name": "Prazo Prometido",
            "expression": "AVERAGE(Entregas[prazo_prometido_dias])",
            "formatString": "0.0\" dias\"",
            "displayFolder": "KPIs",
            "lineageTag": "5933c299-b681-4570-93e0-5b0164fc39dd"
          },
          {
            "name": "Folga do Prazo",
            "expression": "[Prazo Prometido] - [Lead Time Médio]",
            "formatString": "0.0\" dias\"",
            "displayFolder": "KPIs",
            "lineageTag": "1a3e128a-2182-42e2-bd21-e365458b53ff"
          },
          {
            "name": "Frete Médio",
            "expression": "AVERAGE(Entregas[valor_frete])",
            "formatString": "\"R$\" #,0.00",
            "displayFolder": "KPIs",
            "lineageTag": "8c1eadc4-a834-4a71-a57a-7a1cbf7926f9"
          },
          {
            "name": "Frete % do Produto",
            "expression": "DIVIDE(SUM(Entregas[valor_frete]), SUM(Entregas[valor_produtos]))",
            "formatString": "0.0%",
            "displayFolder": "KPIs",
            "lineageTag": "644ac470-4bb4-4f64-bb62-bbfb2a7dacfe"
          },
          {
            "name": "Nota Média",
            "expression": "AVERAGE(Entregas[nota_avaliacao])",
            "formatString": "0.00\" ★\"",
            "displayFolder": "KPIs",
            "lineageTag": "7831c0e6-e016-4572-9a95-f9bb1aad4bab"
          },
          {
            "name": "% Vendedor Postou no Prazo",
            "expression": [
              "DIVIDE(",
              "    CALCULATE(COUNTROWS(Entregas), Entregas[vendedor_postou_no_prazo] = TRUE()),",
              "    COUNTROWS(Entregas)",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "KPIs",
            "lineageTag": "45ad441a-7d23-4c6c-b032-790e8db1c8dd"
          },
          {
            "name": "Dias Aprovação",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(Entregas[dias_aprovacao]),",
              "    Entregas[dias_aprovacao] >= 0,",
              "    Entregas[dias_expedicao] >= 0,",
              "    Entregas[dias_transporte] >= 0",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Etapas",
            "lineageTag": "b6065423-5d86-4202-be93-fc2a4dbaae13"
          },
          {
            "name": "Dias Expedição",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(Entregas[dias_expedicao]),",
              "    Entregas[dias_aprovacao] >= 0,",
              "    Entregas[dias_expedicao] >= 0,",
              "    Entregas[dias_transporte] >= 0",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Etapas",
            "lineageTag": "077c9529-69b8-4cb1-99cd-737a851145d2"
          },
          {
            "name": "Dias Transporte",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(Entregas[dias_transporte]),",
              "    Entregas[dias_aprovacao] >= 0,",
              "    Entregas[dias_expedicao] >= 0,",
              "    Entregas[dias_transporte] >= 0",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Etapas",
            "lineageTag": "b996bd8a-c1e1-4f26-a2f1-4a3609d6d868"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
